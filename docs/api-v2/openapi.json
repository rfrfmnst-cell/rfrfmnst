              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/v2/me": {
      "get": {
        "operationId": "v2Identity",
        "responses": {
          "200": {
            "description": "Draft response; implementation pending",
