        }
      }
    },
    "/v2/orders": {
      "get": {
        "operationId": "v2ListOrders",
        "responses": {
          "200": {
            "description": "Draft response; implementation pending",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrderPage"
                }
              }
            }
          },
          "401": {
            "description": "Draft response; implementation pending",
            "content": {
              "application/json": {
