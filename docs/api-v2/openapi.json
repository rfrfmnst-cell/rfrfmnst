          "503": {
            "description": "Draft response; implementation pending",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "in": "query",
            "name": "cursor",
            "schema": {
              "type": "string",
              "maxLength": 512
            }
          },
          {
            "in": "query",
            "name": "limit",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 25
            }
          }
        ]
      }
    },
    "/v2/orders/{orderId}": {
      "get": {
        "operationId": "v2ReadOrder",
        "responses": {
          "200": {
            "description": "Draft response; implementation pending",
            "content": {
              "application/json": {
                "schema": {
