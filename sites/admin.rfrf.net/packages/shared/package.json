{
  "name": "@rafraf/shared",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "pnpm build --watch",
    "build": "tsc -b -v",
    "check-types": "tsc --noEmit -p tsconfig.json",
    "test": "jest",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --max-warnings 0"
  },
  "main": "./dist/entry.js",
  "types": "./dist/entry.d.ts",
  "files": [
    "./dist/**"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "import": "./dist/entry.js",
      "require": "./dist/entry.js"
    },
    "./*": {
      "import": "./dist/*.js",
      "require": "./dist/*.js"
    }
  },
  "dependencies": {
    "twilio": "6.1.0"
  },
  "devDependencies": {
    "@rafraf/eslint-config": "workspace:*",
    "@rafraf/jest-config": "workspace:*",
    "@rafraf/typescript-config": "workspace:*",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.10.7",
    "eslint": "^9.31.0",
    "jest": "^30.2.0",
    "ts-jest": "^29.4.6",
    "ts-loader": "^9.4.3",
    "ts-node": "^10.9.2",
    "typescript": "5.5.4"
  }
}
